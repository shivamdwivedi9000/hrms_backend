# Backend Environment Variables (Example)
# Replace these with real values in Render dashboard settings

# Database URL from Railway
DATABASE_URL=mysql://root:password@host:port/database

# Secret key for JWT (generate a secure one)
SECRET_KEY=yoursecretkeyhere

# CORS: URL of your frontend on Vercel
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
